{
  "appId": "com.lottydarko.darkotouch",
  "appName": "DARKO-TOUCH 2000",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#f2f2f5"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#f2f2f5",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT",
      "backgroundColor": "#f2f2f5"
    }
  }
}
